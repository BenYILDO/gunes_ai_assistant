# ─────────────────────────────────────────────────────────────
#  Güneş ayarları — bu dosyayı ".env" adıyla kopyalayın.
#  .env asla GitHub'a gönderilmez (.gitignore'da).
# ─────────────────────────────────────────────────────────────

# Kullanıcı
GUNES_USER_NAME=Yıldıray
GUNES_USER_TITLE=Bey
GUNES_USER_ROLE=IT / Dijital Dönüşüm
GUNES_TIMEZONE=Europe/Istanbul
GUNES_PORT=4317

# Supabase (Project Settings → API). Boş bırakılırsa yerel dosya modu kullanılır.
# service_role anahtarı RLS'yi atlar: SADECE bu dosyada dursun, kimseyle paylaşmayın.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude Code CLI (Pro üyeliğinizle giriş yapılmış olmalı: bir kez `claude` çalıştırıp giriş yapın)
# Windows'ta bulunamazsa tam yol verin, örn: C:\Users\<siz>\.local\bin\claude.exe
CLAUDE_BIN=claude

# Modeller: tarama ucuz model, düşünme/sohbet güçlü model
GUNES_MODEL_SCAN=haiku
GUNES_MODEL_THINK=sonnet
GUNES_MODEL_CHAT=sonnet

# claude.ai'de bağlı Microsoft 365 connector'ının Claude Code içindeki adı.
# `npm run doctor -- --live` doğru adı söyler.
GUNES_M365_SERVER=claude_ai_Microsoft_365

# Sabah özetinin Teams'te kendinize gönderileceği sohbet kimliği (boşsa gönderilmez).
# Güneş'e sohbette "kendime not sohbetimin chat id'si ne?" diye sorabilirsiniz.
GUNES_TEAMS_SELF_CHAT_ID=

# Konum (hava durumu teması için). Boşsa arayüz tarayıcı konumunu kullanır; o da yoksa İstanbul.
GUNES_LAT=
GUNES_LON=

# Zamanlama
GUNES_SCHEDULER=on
GUNES_MORNING_TIME=08:30
GUNES_WORK_END=18:00
GUNES_TRACKER_EVERY_HOURS=2
# Toplantı hazırlığı (~15 dk önce) ve toplantı sonrası aksiyonlar: on/off
GUNES_MEETING_PREP=on
GUNES_MEETING_FOLLOWUP=on
# Haftalık rapor + iç gözlem: gün (1=Pzt … 5=Cuma) ve saat
GUNES_WEEKLY_DAY=5
GUNES_WEEKLY_TIME=16:30
# 1=Pazartesi … 7=Pazar
GUNES_WORK_DAYS=1,2,3,4,5

# Geçmiş taraması
GUNES_BACKFILL_DAYS=45
GUNES_BACKFILL_CHUNK_DAYS=7
# Geçmiş taramasında aynı anda çalışan toplayıcı sayısı (Supabase modunda)
GUNES_BACKFILL_PARALLEL=3

# 5 saatlik Claude kullanımı bu oranı geçerse 2 saatlik takip ertelenir (0-1)
GUNES_USAGE_PAUSE_AT=0.85

# Doğal ses: Azure Speech ücretsiz katmanı (F0, ayda 500 bin karakter). Boşsa tarayıcı sesi kullanılır.
# portal.azure.com → "Speech service" oluştur (Fiyat katmanı: Free F0) → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
GUNES_TTS_VOICE=tr-TR-EmelNeural

# Mailleri asla kaçmaması gereken kişiler (virgülle; ad veya e-posta)
GUNES_VIP_PEOPLE=
# Göndereninde bunlar geçen mailler yok sayılır
GUNES_IGNORE=noreply,no-reply,newsletter,bulten,notification,bildirim
